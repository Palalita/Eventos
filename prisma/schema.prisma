// Esquema de la base de datos (Postgres en Neon), leído por Prisma para
// generar el cliente tipado que importa lib/db.ts (`import { db } from
// "@/lib/db"`) y que usa el resto del código para consultar/escribir.
// Cualquier cambio acá requiere una migración (`npx prisma migrate dev`) —
// las migraciones ya aplicadas están en prisma/migrations/.
//
// Cómo se relacionan los modelos:
//   User               — cada persona (admin o invitado). El invitado nace
//                         al usar un código de Invitation (ver signup() en
//                         app/actions/auth.ts).
//   PhotoRequest       — una foto/video subido por un User; pasa por
//                         PENDING -> APPROVED/REJECTED (ver reviewPhoto()).
//   TrustedDevice /
//   DeviceVerification — el flujo de "confirmar dispositivo nuevo por
//                         correo" para los admins (ver lib/device.ts).
//   Invitation         — códigos de invitación que el admin genera y manda
//                         por correo antes de que exista el User.
//   SiteSection        — qué bloques de la home están activados/desactivados.
//   EventSettings      — una única fila con los datos generales del evento.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  GUEST
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// Antes del evento (recuerdos, mensajes) vs. el día del evento en sí.
enum EventPhase {
  PRE_EVENT
  EVENT
}

enum MediaType {
  PHOTO
  VIDEO
}

enum InvitationStatus {
  PENDING
  USED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(GUEST)

  // Invitación con QR único para asistir al evento
  qrToken      String    @unique @default(cuid())
  attended     Boolean   @default(false)
  checkedInAt  DateTime?

  photoRequests       PhotoRequest[]
  trustedDevices      TrustedDevice[]
  deviceVerifications DeviceVerification[]
  createdAt           DateTime @default(now())
}

model PhotoRequest {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // URL pública en Vercel Blob. Solo se revela al cliente cuando status es
  // APPROVED; en PENDING/REJECTED la privacidad la impone /api/fotos/[id].
  fileUrl       String
  mediaType     MediaType   @default(PHOTO)
  phase         EventPhase  @default(EVENT)
  description   String?
  status        PhotoStatus @default(PENDING)
  adminComment  String?
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?
}

// Dispositivo desde el que el admin ya confirmó su identidad por correo.
model TrustedDevice {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// Verificación pendiente por correo cuando el admin entra desde un
// dispositivo que no está en TrustedDevice.
model DeviceVerification {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String   @unique
  deviceToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

// Correo + código que el admin registra de antemano. El invitado necesita
// este código (enviado por correo) para poder crear su cuenta; así solo
// quien fue invitado puede entrar al sitio.
model Invitation {
  id        String           @id @default(cuid())
  email     String           @unique
  code      String           @unique
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  usedAt    DateTime?
}

// Activar/desactivar secciones del sitio para los invitados.
model SiteSection {
  key     String  @id
  label   String
  enabled Boolean @default(true)
}

// Contenido editable del evento (una sola fila).
model EventSettings {
  id                String   @id @default("singleton")
  quinceaneraNombre String
  fechaEvento       DateTime
  lugar             String
  lema              String
  indicaciones      String   @default("")
  saveTheDateMensaje String  @default("")
  fotoPrincipalUrl  String   @default("")
  updatedAt         DateTime @updatedAt
}
