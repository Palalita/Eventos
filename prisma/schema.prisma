generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  GUEST
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// Antes del evento (recuerdos, mensajes) vs. el día del evento en sí.
enum EventPhase {
  PRE_EVENT
  EVENT
}

enum MediaType {
  PHOTO
  VIDEO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(GUEST)

  // Invitación con QR único para asistir al evento
  qrToken      String    @unique @default(cuid())
  attended     Boolean   @default(false)
  checkedInAt  DateTime?

  photoRequests       PhotoRequest[]
  trustedDevices      TrustedDevice[]
  deviceVerifications DeviceVerification[]
  createdAt           DateTime @default(now())
}

model PhotoRequest {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // URL pública en Vercel Blob. Solo se revela al cliente cuando status es
  // APPROVED; en PENDING/REJECTED la privacidad la impone /api/fotos/[id].
  fileUrl       String
  mediaType     MediaType   @default(PHOTO)
  phase         EventPhase  @default(EVENT)
  description   String?
  status        PhotoStatus @default(PENDING)
  adminComment  String?
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?
}

// Dispositivo desde el que el admin ya confirmó su identidad por correo.
model TrustedDevice {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// Verificación pendiente por correo cuando el admin entra desde un
// dispositivo que no está en TrustedDevice.
model DeviceVerification {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String   @unique
  deviceToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

// Activar/desactivar secciones del sitio para los invitados.
model SiteSection {
  key     String  @id
  label   String
  enabled Boolean @default(true)
}

// Contenido editable del evento (una sola fila).
model EventSettings {
  id                String   @id @default("singleton")
  quinceaneraNombre String
  fechaEvento       DateTime
  lugar             String
  lema              String
  indicaciones      String   @default("")
  saveTheDateMensaje String  @default("")
  updatedAt         DateTime @updatedAt
}
